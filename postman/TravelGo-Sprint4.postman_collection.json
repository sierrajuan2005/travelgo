    {
      "name": "03 Hoteles reales (Integrante 2)",
      "item": [
        {
          "name": "Hoteles de una ciudad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hoteles-reales?ciudad={{ciudadClave}}&limite=5"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Trae hoteles', function () { const l = pm.response.json(); pm.expect(l).to.be.an('array'); if (l.length) { pm.collectionVariables.set('hotelClave', l[0].clave); } });"
                ]
              }
            }
          ]
        },
        {
          "name": "Tarifa de un hotel (usa el primero de la lista)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hoteles-reales/{{hotelClave}}/tarifa?entrada={{fechaEntrada}}&salida={{fechaSalida}}&habitaciones=1&adultos=2"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con tarifa o 204/404 si la fuente no tiene', function () { pm.expect([200,204,404]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Fechas inválidas (salida antes de entrada)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hoteles-reales/{{hotelClave}}/tarifa?entrada=2030-01-10&salida=2030-01-05"
            }
          },
          "event": [
