{
  "info": {
    "name": "TravelGo - Sprint 4 (búsqueda, destinos y hoteles reales)",
    "description": "Colección de Integrante 4. Arrancar la app con DB_PASSWORD (y IGNAV_API_KEY si se prueban vuelos). Ejecutar primero '00 Sesión'. No guardar llaves de APIs en esta colección. Los endpoints de vuelos y paquetes reales se agregan cuando existan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Sesión",
      "item": [
        {
          "name": "Login como ADMINISTRADOR",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{emailAdmin}}"
                },
                {
                  "key": "password",
                  "value": "{{passAdmin}}"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrf}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/login', method: 'GET' }, function (err, res) {",
                  "  if (err) { console.error(err); return; }",
                  "  const t = /name=\"_csrf\"[^>]*value=\"([^\"]+)\"/.exec(res.text()) || /value=\"([^\"]+)\"[^>]*name=\"_csrf\"/.exec(res.text());",
                  "  if (t) { pm.collectionVariables.set('csrf', t[1]); } else { console.warn('No se encontró el token CSRF en /login'); }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto: redirige fuera de /login?error', function () {",
                  "  pm.response.to.have.status(302);",
                  "  pm.expect(pm.response.headers.get('Location') || '').to.not.include('error');",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    },
    {
      "name": "01 Búsqueda y filtros de paquetes",
      "item": [
        {
          "name": "Sin filtros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paquetes/buscar"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve una lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Por destino (sin tildes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paquetes/buscar?destino=bogota"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Solo Bogotá', function () { pm.response.json().forEach(p => pm.expect(JSON.stringify(p.destinos).toLowerCase()).to.include('bogot')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Por rango de precio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paquetes/buscar?precioMin=800000&precioMax=1500000"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Precios dentro del rango', function () { pm.response.json().forEach(p => pm.expect(p.precio).to.be.within(800000,1500000)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Por duración",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paquetes/buscar?duracionMin=4&duracionMax=5"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Duración dentro del rango', function () { pm.response.json().forEach(p => pm.expect(p.duracionDias).to.be.within(4,5)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtros combinados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paquetes/buscar?destino=colombia&precioMax=2000000&duracionMin=3"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin resultados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paquetes/buscar?destino=tokio"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Lista vacía', function () { pm.expect(pm.response.json()).to.have.lengthOf(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rango de precio al revés (error)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paquetes/buscar?precioMin=5000000&precioMax=100"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
